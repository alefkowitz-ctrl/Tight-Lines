{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {"source": "/api/(.*)", "destination": "/api/$1"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "crons": [
    {"path": "/api/sync-nwps-gauges", "schedule": "0 6 * * 0"}
  ]
}
